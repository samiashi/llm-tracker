# The server's settings for GitHub sign-in. Local development needs none of
# them: with no .env, `make run-server` serves this machine only, without
# sign-in. To sign in with GitHub locally, copy this file, fill the copy in,
# and keep this one free of values:
#
#   cp .env.example .env
#   make run-server
#
# .env is gitignored. Set one key and every key is required: the server names
# any that is missing and does not start. The Google Cloud deployment keeps
# its own copy in Secret Manager (deploy/gcp/deploy.sh writes it).

# A GitHub OAuth app owned by the org, with the callback
# <LLM_TRACKER_BASE_URL>/auth/callback. An app has one callback, so local
# development needs an app of its own:
#   https://github.com/organizations/your-org/settings/applications/new
LLM_TRACKER_GITHUB_CLIENT_ID=
LLM_TRACKER_GITHUB_CLIENT_SECRET=

# Only members of this org can see the dashboard or enrol a machine.
LLM_TRACKER_GITHUB_ORG=your-org

# The address the server is reached at, which the callback is built from.
LLM_TRACKER_BASE_URL=http://127.0.0.1:8790

# Signs session cookies; at least 32 bytes.  openssl rand -hex 32
LLM_TRACKER_SESSION_KEY=
